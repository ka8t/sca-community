rule taint_sqli
  language  python
  category  security
  severity  HIGH
  confidence 90
  source  request\.(GET|POST|args|form|json|data)  kind=http
  source  request\.(query_params|path_params|cookies|headers)  kind=http
  source  request\.url  kind=http
  source  request\.client  kind=http
  source  flask\.request\.  kind=http
  source  Body\s*\(  kind=http
  source  Query\s*\(  kind=http
  source  Form\s*\(  kind=http
  source  Header\s*\(  kind=http
  source  input\s*\(  kind=stdin
  source  sys\.argv\[  kind=cli
  source  os\.environ  kind=env
  source  request\.query_string  kind=http
  source  request\.cookies  kind=http
  source  request\.path  kind=http
  source  request\.remote_addr  kind=http
  source  request\.user_agent  kind=http
  source  request\.referrer  kind=http
  source  request\.content_type  kind=http
  source  request\.get_json\s*\(  kind=http
  source  request\.values  kind=http
  source  request\.cookies\.get\s*\(  kind=http
  source  request\.cookies\[  kind=http
  source  request\.form\.getlist\s*\(  kind=http
  source  request\.args\.getlist\s*\(  kind=http
  source  wrapped\.get_form_parameter\s*\(  kind=http
  source  wrapped\.get_query_parameter\s*\(  kind=http
  source  wrapped\.get_cookie\s*\(  kind=http
  source  wrapped\.get_header\s*\(  kind=http
  source  helpers\.utils\.get_parameter\s*\(  kind=http
  source  helpers\.utils\.get_parameter_list\s*\(  kind=http
  sink    \.execute\s*\((?![^)]*,)
  sink    \.executemany\s*\((?![^)]*,)
  sink    \.executescript\s*\(
  sink    \.raw\s*\(
  sink    \btext\s*\(\s*["']
  sink    \.filter\s*\(\s*["']
  sink    \$queryRaw\s*\(
  sanitizer  psycopg2\.sql\.SQL
  sanitizer  sqlalchemy\.text
  sanitizer  \bint\s*\(
  sanitizer  \bselect\s*\(
  sanitizer  bindparam
  sanitizer  \bUUID\s*\(
  sanitizer  \.startswith\s*\(
  sanitizer  \.endswith\s*\(
  sanitizer  \.isalnum\s*\(
  sanitizer  \.isalpha\s*\(
  sanitizer  re\.match
  sanitizer  re\.fullmatch
  passthrough  str\s*\(
  passthrough  \.strip\s*\(
  passthrough  \.lstrip\s*\(
  passthrough  \.rstrip\s*\(
  passthrough  \.lower\s*\(
  passthrough  \.upper\s*\(
  passthrough  \.encode\s*\(
  passthrough  \.decode\s*\(
  passthrough  urllib\.parse\.unquote
  passthrough  urllib\.parse\.quote
  passthrough  json\.loads
  passthrough  json\.dumps
  passthrough  base64\.b64decode
  passthrough  \.replace\s*\(
  passthrough  \.format\s*\(
  passthrough  urllib\.parse\.unquote_plus
  passthrough  base64\.b64encode
  passthrough  base64\.urlsafe_b64decode
  passthrough  base64\.urlsafe_b64encode
  passthrough  configparser.*\.get\s*\(
  passthrough  \.encode\s*\(.*utf
  passthrough  \.decode\s*\(.*utf
  passthrough  str\.maketrans
  passthrough  \.translate\s*\(
  passthrough  \.split\s*\(
  passthrough  \.join\s*\(
  passthrough  \[\d+:-?\d*\]
  passthrough  request_wrapper\s*\(
  message
    en: SQL Injection — tainted data flows into a SQL query without parameterization
    fr: Injection SQL — données non fiables atteignent une requête SQL sans paramétrage
  end
  risk
    en: An attacker can read, modify, or delete database records.
    fr: Un attaquant peut lire, modifier ou supprimer des enregistrements de la base de données.
    es: Un atacante puede leer, modificar o eliminar registros de la base de datos.
    de: Ein Angreifer kann Datenbankeintraege lesen, aendern oder loeschen.
  end
  solution
    en: Use parameterized queries with placeholders (%s, ?).
    fr: Utilisez des requêtes paramétrées avec des placeholders (%s, ?).
    es: Usar consultas parametrizadas con placeholders (%s, ?).
    de: Verwenden Sie parametrisierte Abfragen mit Platzhaltern (%s, ?).
  end
  metadata
    cwe    CWE-89
    owasp  A03:2021
    iso27001  A.8.28
  end
  benefit
    en: Reduces attack surface and strengthens application security.
    fr: Reduit la surface d'attaque et renforce la securite de l'application.
    es: Reduce la superficie de ataque y refuerza la seguridad de la aplicacion.
    de: Reduziert die Angriffsflaeche und staerkt die Anwendungssicherheit.
  end
  fix_before
    user_id = request.args.get("id")
    db.execute(f"SELECT * FROM users WHERE id = {user_id}")
  end
  fix_after
    user_id = request.args.get("id")
    db.execute("SELECT * FROM users WHERE id = %s", (user_id,))
  end
  requires
    demo_fallback  true
  end
end
