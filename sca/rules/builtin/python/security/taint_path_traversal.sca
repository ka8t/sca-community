rule taint_path_traversal
  language  python
  category  security
  severity  HIGH
  confidence 85
  source  request\.(GET|POST|args|form|json|data)  kind=http
  source  request\.(query_params|path_params|cookies|headers)  kind=http
  source  Body\s*\(  kind=http
  source  Query\s*\(  kind=http
  source  =\s*Path\s*\(  kind=http
  source  request\.query_string  kind=http
  source  input\s*\(  kind=stdin
  source  sys\.argv\[  kind=cli
  source  request\.cookies  kind=http
  source  request\.url  kind=http
  source  request\.path  kind=http
  source  request\.remote_addr  kind=http
  source  request\.user_agent  kind=http
  source  request\.referrer  kind=http
  source  request\.content_type  kind=http
  source  request\.get_json\s*\(  kind=http
  source  request\.values  kind=http
  source  request\.cookies\.get\s*\(  kind=http
  source  request\.cookies\[  kind=http
  source  request\.form\.getlist\s*\(  kind=http
  source  request\.args\.getlist\s*\(  kind=http
  source  wrapped\.get_form_parameter\s*\(  kind=http
  source  wrapped\.get_query_parameter\s*\(  kind=http
  source  wrapped\.get_cookie\s*\(  kind=http
  source  wrapped\.get_header\s*\(  kind=http
  source  helpers\.utils\.get_parameter\s*\(  kind=http
  source  helpers\.utils\.get_parameter_list\s*\(  kind=http
  sink    \bopen\s*\(
  sink    Path\s*\(
  sink    send_file\s*\(
  sink    codecs\.open\s*\(
  sink    os\.path\.exists\s*\(
  sink    pathlib\.Path\s*\(
  sink    \.exists\s*\(
  sink    \.read_text\s*\(
  sink    \.read_bytes\s*\(
  sink    \.write_text\s*\(
  sink    \.unlink\s*\(
  sanitizer  os\.path\.realpath
  sanitizer  os\.path\.abspath
  sanitizer  Path\.resolve
  sanitizer  secure_filename
  sanitizer  \.startswith\s*\(
  sanitizer  \.endswith\s*\(
  sanitizer  \.isalnum\s*\(
  sanitizer  \.isalpha\s*\(
  sanitizer  re\.match
  sanitizer  re\.fullmatch
  passthrough  str\s*\(
  passthrough  \.strip\s*\(
  passthrough  \.lstrip\s*\(
  passthrough  \.rstrip\s*\(
  passthrough  \.lower\s*\(
  passthrough  \.upper\s*\(
  passthrough  \.encode\s*\(
  passthrough  \.decode\s*\(
  passthrough  urllib\.parse\.unquote
  passthrough  urllib\.parse\.quote
  passthrough  json\.loads
  passthrough  json\.dumps
  passthrough  base64\.b64decode
  passthrough  \.replace\s*\(
  passthrough  \.format\s*\(
  passthrough  urllib\.parse\.unquote_plus
  passthrough  base64\.b64encode
  passthrough  base64\.urlsafe_b64decode
  passthrough  base64\.urlsafe_b64encode
  passthrough  configparser.*\.get\s*\(
  passthrough  \.encode\s*\(.*utf
  passthrough  \.decode\s*\(.*utf
  passthrough  str\.maketrans
  passthrough  \.translate\s*\(
  passthrough  \.split\s*\(
  passthrough  \.join\s*\(
  passthrough  \[\d+:-?\d*\]
  passthrough  request_wrapper\s*\(
  message
    en: Path Traversal — tainted data used as a file path without validation
    fr: Path Traversal — données non fiables utilisées comme chemin de fichier sans validation
  end
  risk
    en: An attacker can read or write arbitrary files outside the intended directory.
    fr: Un attaquant peut lire ou écrire des fichiers arbitraires hors du répertoire prévu.
    es: Un atacante puede leer o escribir archivos arbitrarios fuera del directorio previsto.
    de: Ein Angreifer kann beliebige Dateien ausserhalb des vorgesehenen Verzeichnisses lesen oder schreiben.
  end
  solution
    en: Validate file paths with os.path.realpath() and ensure they stay within the allowed directory.
    fr: Validez les chemins avec os.path.realpath() et vérifiez qu'ils restent dans le répertoire autorisé.
    es: Validar rutas de archivos con os.path.realpath() y asegurar que permanezcan dentro del directorio permitido.
    de: Dateipfade mit os.path.realpath() validieren und sicherstellen, dass sie im erlaubten Verzeichnis bleiben.
  end
  metadata
    cwe    CWE-22
    cwe    CWE-23
    cwe    CWE-73
    owasp  A01:2021
    iso27001  A.8.23
  end
  benefit
    en: Reduces attack surface and strengthens application security.
    fr: Reduit la surface d'attaque et renforce la securite de l'application.
    es: Reduce la superficie de ataque y refuerza la seguridad de la aplicacion.
    de: Reduziert die Angriffsflaeche und staerkt die Anwendungssicherheit.
  end
  fix_before
    filename = request.args.get("file")
    content = open(os.path.join(BASE, filename)).read()
  end
  fix_after
    filename = request.args.get("file")
    safe = os.path.realpath(os.path.join(BASE, filename))
    if not safe.startswith(os.path.realpath(BASE)):
        abort(403)
    content = open(safe).read()
  end
  requires
    demo_fallback  true
  end
end
